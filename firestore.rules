rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['owner', 'staff'];
    }

    function validRequestCreate() {
      return request.resource.data.keys().hasOnly([
        'createdAt', 'name', 'phone', 'vehicle', 'problem', 'notes',
        'locationText', 'latitude', 'longitude', 'locationAccuracy', 'status'
      ])
      && request.resource.data.keys().hasAll([
        'createdAt', 'name', 'phone', 'vehicle', 'problem', 'notes',
        'locationText', 'status'
      ])
      && request.resource.data.createdAt is string
      && request.resource.data.name is string
      && request.resource.data.phone is string
      && request.resource.data.vehicle is string
      && request.resource.data.problem is string
      && request.resource.data.notes is string
      && request.resource.data.locationText is string
      && request.resource.data.status == 'New'
      && (!request.resource.data.keys().hasAny(['latitude']) || request.resource.data.latitude is number)
      && (!request.resource.data.keys().hasAny(['longitude']) || request.resource.data.longitude is number)
      && (!request.resource.data.keys().hasAny(['locationAccuracy']) || request.resource.data.locationAccuracy is number);
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /assistanceRequests/{requestId} {
      allow create: if validRequestCreate();
      allow read, update, delete: if isAdmin();
    }

    match /tyreInventory/{itemId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
